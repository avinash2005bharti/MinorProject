PORT=5000
NODE_ENV=production

# Database 1: MySQL (Academic & Scheduling Source of Truth)
MYSQL_DATABASE_URL=mysql://username:password@cloud-mysql-host:3306/campusflow_cse
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cse_erp
MYSQL_USER=root
MYSQL_PASSWORD=

# Database 2: MongoDB (Application Data + STM)
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/cse_erp?retryWrites=true&w=majority

# Python FastAPI AI Service URL
PYTHON_AI_SERVICE_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

# Security & JWT
JWT_SECRET=production_jwt_secret_min_32_characters
JWT_REFRESH_SECRET=production_jwt_refresh_secret
JWT_EXPIRES_IN=7d

# File Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=campusflow-erp-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_PATH=uploads

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Notification Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cse.erp@college.edu
BREVO_SENDER_NAME="CSE Department Office"

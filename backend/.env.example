PORT=5000
NODE_ENV=production

# Database 1: PostgreSQL (Primary ERP Relational Source of Truth - Render PostgreSQL / Local)
# Connect using standard DATABASE_URL (Render PostgreSQL provided automatically)
DATABASE_URL=postgresql://user:password@hostname:5432/cse_erp

# Or discrete parameters for local PostgreSQL development:
PGHOST=localhost
PGPORT=5432
PGDATABASE=cse_erp
PGUSER=postgres
PGPASSWORD=
DB_SSL=false
USE_POSTGRES=true

# Connection Pooling (Render-optimized limits)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Database 2: MongoDB (Application Data + STM - MongoDB Atlas)
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/cse_erp?retryWrites=true&w=majority

# Frontend origin allowed to call the backend.
# Local: http://localhost:5173
# Deployment: set this to the public frontend URL, e.g. https://oistcse.onrender.com
FRONTEND_URL=http://localhost:5173

# Public backend URL used when returning uploaded-file URLs.
BACKEND_URL=http://localhost:5000

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000
# Legacy alias supported for existing deployments:
PYTHON_AI_SERVICE_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

# Security & JWT (SEC-07, SEC-08, SEC-09)
JWT_SECRET=production_jwt_secret_min_32_characters
JWT_REFRESH_SECRET=production_jwt_refresh_secret
JWT_EXPIRES_IN=7d
ADMIN_REGISTRATION_SECRET=super_secret_admin_registration_passphrase_min_32_chars
INTERNAL_API_SECRET=super_secret_internal_microservice_api_key_min_32_chars
CUSTOM_DNS_SERVERS=

# File Storage (ImageKit Cloud / Local Fallback)
STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
STORAGE_BUCKET=campusflow-erp-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_PATH=uploads

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Notification Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cse.erp@college.edu
BREVO_SENDER_NAME="CSE Department Office"

# Qdrant Vector Database
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LTM_COLLECTION=erp_long_term_memory
QDRANT_RAG_COLLECTION=erp_documents

# LLM & Embedding Providers (Groq LLM + Google Gemini Embeddings)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
GEMINI_API_KEY=

AI_SERVICE_URL=http://localhost:8000
FILE_STORAGE_PATH=uploads

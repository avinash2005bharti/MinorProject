# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# Vector Database: Qdrant Cloud (LTM + RAG)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_LTM_COLLECTION=erp_long_term_memory
QDRANT_RAG_COLLECTION=erp_documents

# MongoDB (Short-Term Conversational Memory STM)
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/cse_erp?retryWrites=true&w=majority

# PostgreSQL (Academic & Scheduling Source of Truth - Render PostgreSQL / Local)
DATABASE_URL=postgresql://username:password@hostname:5432/cse_erp
PGHOST=localhost
PGPORT=5432
PGDATABASE=cse_erp
PGUSER=postgres
PGPASSWORD=
DB_SSL=false

# Deliverables / Object Storage (ImageKit Cloud / Local Fallback)
STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
STORAGE_BUCKET=campusflow-erp-documents
OUTPUT_FILE_DIR=../backend/uploads
FILE_STORAGE_PATH=../backend/uploads

# LLM Providers (Groq Cloud LLM)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# Embedding Model (Google Gemini Embeddings)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
GEMINI_API_KEY=
MAX_CONTEXT_TOKENS=4096


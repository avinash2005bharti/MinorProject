# ==============================================================================
# CampusFlow AI Microservice Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Groq Cloud LLM)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Microservice URLs
# Deployment: https://oistcseai.onrender.com
# Localhost:  http://localhost:8000
AI_SERVICE_URL=https://oistcseai.onrender.com

# Backend URL used by the AI service to call authenticated backend APIs.
# Deployment: https://oistcse-server.onrender.com
# Localhost:  http://localhost:5000
BACKEND_URL=https://oistcse-server.onrender.com
NODE_BACKEND_URL=https://oistcse-server.onrender.com
FRONTEND_URL=https://oistcse.onrender.com

# Localhost option:
# AI_SERVICE_URL=http://localhost:8000
# BACKEND_URL=http://localhost:5000
# NODE_BACKEND_URL=http://localhost:5000
# FRONTEND_URL=http://localhost:5173

INTERNAL_API_SECRET=your_shared_internal_secret_here

# Embedding Configuration (Local SentenceTransformers or Gemini / OpenAI)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_CONTEXT_TOKENS=4096

# Vector Database: Qdrant Cloud (LTM + RAG)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_LTM_COLLECTION=erp_long_term_memory
QDRANT_RAG_COLLECTION=erp_documents

# MongoDB (Short-Term Conversational Memory STM)
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/cse_erp?retryWrites=true&w=majority

# PostgreSQL (Academic & Scheduling Source of Truth - Render PostgreSQL / Local)
DATABASE_URL=postgresql://username:password@hostname:5432/cse_erp
PGHOST=localhost
PGPORT=5432
PGDATABASE=cse_erp
PGUSER=postgres
PGPASSWORD=
DB_SSL=false

# Deliverables / Object Storage (ImageKit Cloud / Local Fallback)
STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
STORAGE_BUCKET=campusflow-erp-documents
OUTPUT_FILE_DIR=../backend/uploads
FILE_STORAGE_PATH=../backend/uploads

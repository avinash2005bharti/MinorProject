# ==============================================================================
# CLOUD-BASED AGENTIC DEPARTMENTAL ERP BACKEND - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# DEPLOYMENT LINKS & INTER-SERVICE URLs
# ------------------------------------------------------------------------------
# Backend:    https://oistcse-server.onrender.com
# AI Service: https://oistcseai.onrender.com
# Frontend:   https://oistcse.onrender.com

BACKEND_URL=https://oistcse-server.onrender.com
FRONTEND_URL=https://oistcse.onrender.com
AI_SERVICE_URL=https://oistcseai.onrender.com
FASTAPI_URL=https://oistcseai.onrender.com
PYTHON_AI_SERVICE_URL=https://oistcseai.onrender.com

# Localhost options for local development & adding new microservices:
# BACKEND_URL=http://localhost:5000
# FRONTEND_URL=http://localhost:5173
# AI_SERVICE_URL=http://localhost:8000
# FASTAPI_URL=http://localhost:8000
# PYTHON_AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 1. DATABASE 1: POSTGRESQL (ACADEMIC & SCHEDULING RELATIONAL SOURCE OF TRUTH)
# ------------------------------------------------------------------------------
# Render PostgreSQL Connection URI (automatically provisioned on Render)
DATABASE_URL=postgresql://username:password@dpg-xxxxxx.oregon-postgres.render.com/cse_erp

# Discrete parameters for local PostgreSQL development:
PGHOST=localhost
PGPORT=5432
PGDATABASE=cse_erp
PGUSER=postgres
PGPASSWORD=
DB_SSL=false
USE_POSTGRES=true

# Connection Pooling
DB_POOL_MAX=10
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# 2. DATABASE 2: MONGODB (APPLICATION DATA + CONVERSATIONAL SHORT-TERM MEMORY STM)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.region.mongodb.net/campusflow_cse?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE: QDRANT (SEMANTIC LONG-TERM MEMORY LTM + RAG)
# ------------------------------------------------------------------------------
# Qdrant Cloud Cluster URL & API Key
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_LTM_COLLECTION=erp_long_term_memory
QDRANT_RAG_COLLECTION=erp_documents

# ------------------------------------------------------------------------------
# 4. LLM & REASONING CONFIGURATION (GROQ CLOUD)
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_production_jwt_signing_key_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_token_key_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_REGISTRATION_SECRET=super_secret_admin_registration_passphrase_min_32_chars
INTERNAL_API_SECRET=super_secret_internal_microservice_api_key_min_32_chars
CORS_ORIGINS=https://oistcse.onrender.com,http://localhost:5173,http://localhost:3000
CUSTOM_DNS_SERVERS=

# ------------------------------------------------------------------------------
# 6. OBJECT & FILE STORAGE (IMAGEKIT CLOUD / LOCAL FALLBACK)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
STORAGE_BUCKET=campusflow-erp-documents
UPLOAD_PATH=uploads
FILE_STORAGE_PATH=uploads

# ------------------------------------------------------------------------------
# 7. EMBEDDING PROVIDER (GOOGLE GEMINI EMBEDDINGS)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 8. NOTIFICATION SERVICE (BREVO / TRANSACTIONAL EMAIL)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=cse.department@college.edu
BREVO_SENDER_NAME="CSE Department Office"

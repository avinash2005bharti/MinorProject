# ==============================================================================
# CLOUD-BASED AGENTIC DEPARTMENTAL ERP BACKEND - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=5000
FASTAPI_URL=http://localhost:8000
PYTHON_AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 1. DATABASE 1: MYSQL (ACADEMIC & SCHEDULING SOURCE OF TRUTH)
# ------------------------------------------------------------------------------
# Cloud Connection URI (e.g. AWS RDS, PlanetScale, Aiven, GCP Cloud SQL)
MYSQL_DATABASE_URL=mysql://username:password@cloud-mysql-host.region.rds.amazonaws.com:3306/campusflow_cse

# Discrete parameters (Alternative to MYSQL_DATABASE_URL)
MYSQL_HOST=cloud-mysql-host.region.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=campusflow_cse
MYSQL_USER=admin
MYSQL_PASSWORD=secure_cloud_password

# ------------------------------------------------------------------------------
# 2. DATABASE 2: MONGODB (APPLICATION DATA + CONVERSATIONAL SHORT-TERM MEMORY STM)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.region.mongodb.net/campusflow_cse?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE: QDRANT (SEMANTIC LONG-TERM MEMORY LTM + RAG)
# ------------------------------------------------------------------------------
# Qdrant Cloud Cluster URL & API Key
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_LTM_COLLECTION=erp_long_term_memory
QDRANT_RAG_COLLECTION=erp_documents

# ------------------------------------------------------------------------------
# 4. LLM & REASONING CONFIGURATION
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_or_openai_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_production_jwt_signing_key_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_token_key_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE FOR GENERATED DELIVERABLES (PDF / EXCEL TIMETABLES)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=campusflow-erp-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_s3_or_gcs_access_key
STORAGE_SECRET_KEY=your_s3_or_gcs_secret_key
UPLOAD_PATH=uploads

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=notifications@college.edu
BREVO_SENDER_NAME=CSE Department Office
